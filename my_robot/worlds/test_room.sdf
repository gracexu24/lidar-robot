<?xml version="1.0"?>
<sdf version="1.9">
  <world name="test_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 2.5 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -2.5 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.1 5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.1 5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="center_obstacle">
      <static>true</static>
      <pose>1 0.6 0.4 0 0 0</pose>
      <link name="box">
        <collision name="collision"><geometry><box><size>0.7 0.7 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.8</size></box></geometry>
          <material><diffuse>0.7 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lidar_robot">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_footprint">
        <inertial>
          <pose>0 0 0.049 0 0 0</pose>
          <mass>8.0</mass>
          <inertia>
            <ixx>0.08</ixx><iyy>0.10</iyy><izz>0.16</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <pose>0 0 0.049 0 0 0</pose>
          <geometry><box><size>0.24 0.16 0.04</size></box></geometry>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0.049 0 0 0</pose>
          <geometry><box><size>0.24 0.16 0.04</size></box></geometry>
          <material><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.10 0 0.182 0 0 0</pose>
          <topic>/scan</topic>
          <gz_frame_id>base_laser</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>500</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>6.283185307</max_angle>
              </horizontal>
            </scan>
            <range><min>0.02</min><max>12.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
        <sensor name="imu" type="imu">
          <pose>0.075 0 0.104 0 0 1.5708</pose>
          <topic>/imu/data</topic>
          <gz_frame_id>imu_link</gz_frame_id>
          <update_rate>100</update_rate>
          <always_on>true</always_on>
        </sensor>
      </link>

      <!-- Wheel X positions assume a 0.22 m wheelbase. -->
      <link name="left_front_wheel">
        <pose>0.11 0.0825 0.049 -1.570796327 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></visual>
      </link>
      <link name="left_rear_wheel">
        <pose>-0.11 0.0825 0.049 -1.570796327 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></visual>
      </link>
      <link name="right_front_wheel">
        <pose>0.11 -0.0825 0.049 -1.570796327 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></visual>
      </link>
      <link name="right_rear_wheel">
        <pose>-0.11 -0.0825 0.049 -1.570796327 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.049</radius><length>0.03</length></cylinder></geometry></visual>
      </link>

      <joint name="left_front_joint" type="revolute">
        <parent>base_footprint</parent><child>left_front_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="left_rear_joint" type="revolute">
        <parent>base_footprint</parent><child>left_rear_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="right_front_joint" type="revolute">
        <parent>base_footprint</parent><child>right_front_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="right_rear_joint" type="revolute">
        <parent>base_footprint</parent><child>right_rear_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>right_front_joint</left_joint>
        <left_joint>right_rear_joint</left_joint>
        <right_joint>left_front_joint</right_joint>
        <right_joint>left_rear_joint</right_joint>
        <wheel_separation>0.165</wheel_separation>
        <wheel_radius>0.049</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
